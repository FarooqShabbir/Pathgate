FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# The ALB does not strip /app1/ before forwarding, so the API call
# has to target the site root's literal /api/* (which the ALB DOES
# route straight to the backend target group) instead of the
# relative path v1/Beanstalk use. See src/App.jsx.
ENV VITE_API_BASE=/api
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.ecs.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
