# Substitutes docker-compose.yml's ${VARS} at deploy time. Terraform
# also sets these same values directly as EB environment properties
# (see eb.tf's option_settings), so this file exists mainly to
# document what the compose file expects -- if you deploy with the
# `eb` CLI instead of Terraform, set these here.
option_settings:
  aws:elasticbeanstalk:application:environment:
    STORAGE_BACKEND: postgres
    POSTGRES_DB: pathgate
    POSTGRES_USER: pathgate
