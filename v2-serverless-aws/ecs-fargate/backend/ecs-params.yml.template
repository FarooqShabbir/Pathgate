version: 1
task_definition:
  task_execution_role: ${EXECUTION_ROLE_ARN}
  ecs_network_mode: awsvpc
  task_size:
    mem_limit: 0.5GB
    cpu_limit: 256
run_params:
  network_configuration:
    awsvpc_configuration:
      subnets:
        - "${SUBNET_ID}"
      security_groups:
        - "${SG_BACKEND_ID}"
      assign_public_ip: ENABLED
service_discovery:
  container_name: backend
  container_port: 8000
  private_dns_namespace:
    vpc: "${VPC_ID}"
    name: pathgate.local
  service_discovery_service:
    name: backend
