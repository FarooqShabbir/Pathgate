# Replaces apps/frontend-insert/nginx.conf (or frontend-list's) on
# whichever EC2 instance is building that frontend's image, so its
# baked-in upstream is the backend instance's PRIVATE IP instead of
# the Docker Compose service name "backend" (which only resolves
# inside a shared bridge network, not across separate hosts). Render
# with render-frontend-nginx.sh before `docker build`.
server {
  listen 3000;

  location /api/ {
    proxy_pass http://${BACKEND_IP}:8000/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /index.html;
  }
}
