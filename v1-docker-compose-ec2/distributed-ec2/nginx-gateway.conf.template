# Top-level (gateway) nginx for the 5-instance manual EC2 deployment.
# Same routing as v1-docker-compose-ec2/nginx/nginx.conf, except the
# upstreams are private IPs instead of Docker service names, because
# a bridge network doesn't span separate hosts. Render this with
# render-gateway-nginx.sh, which fills in ${FRONTEND1_IP} /
# ${FRONTEND2_IP} and leaves nginx's own $variables untouched.
#
# Note what is NOT in this file: "backend" appears nowhere. This
# instance's security group (sg-nginx) also has no rule allowing it to
# reach port 8000 anywhere -- the constraint holds at the network
# layer even if this config were ever edited by mistake.
worker_processes auto;
events { worker_connections 1024; }

http {
  server {
    listen 80;

    location = /app1 { return 302 /app1/; }
    location = /app2 { return 302 /app2/; }

    location /app1/ {
      proxy_pass http://${FRONTEND1_IP}:3000/;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /app2/ {
      proxy_pass http://${FRONTEND2_IP}:3000/;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
      default_type text/plain;
      return 200 "Pathgate demo (distributed EC2).\nVisit /app1 to insert data or /app2 to list data.\n";
    }
  }
}
