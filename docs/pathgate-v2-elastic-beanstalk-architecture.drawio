    </mxCell>

    <mxCell id="fe2" value="&lt;img src='https://icons.diagrams.net/assets/carbon-icons/1/Logo_React.svg' width='20' height='20'/&gt;&lt;br&gt;&lt;b&gt;frontend2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#1f4e79&quot;&gt;image: pathgate-eb-compose-frontend-list&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#3f7fbf&quot;&gt;LIST ONLY · own nginx&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#3f7fbf;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="980" y="720" width="320" height="180" as="geometry" />
    </mxCell>

    <mxCell id="backend" value="&lt;b&gt;backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#8a3a0f&quot;&gt;image: pathgate-eb-compose-backend&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#b3541e&quot;&gt;reached only via frontends&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 8000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeee0;strokeColor=#b3541e;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="640" y="980" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="db" value="&lt;b&gt;db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#4a3572&quot;&gt;PostgreSQL 16&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#6b4fa0&quot;&gt;reached only via backend — no RDS,&lt;br&gt;plain container on this instance&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 5432&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe9fb;strokeColor=#6b4fa0;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="640" y="1170" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="vol" value="&lt;b&gt;db_data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Docker volume on&lt;br&gt;the instance's EBS&lt;/font&gt;" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8a8f96;fontColor=#5b6167;fontSize=13;arcSize=8;" vertex="1" parent="1">
      <mxGeometry x="960" y="1180" width="220" height="120" as="geometry" />
    </mxCell>

    <mxCell id="e1" value="① :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#1a1d1f;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="client" target="eip">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e2" value="② instance :80 → nginx container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#8a4200;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eip" target="nginx">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e3" value="③ /app1 → :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#0f6e63;strokeWidth=1.5;endArrow=block;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nginx" target="fe1">
