      </mxGeometry>
    </mxCell>

    <mxCell id="e4" value="③ /app2 → :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#0f6e63;strokeWidth=1.5;endArrow=block;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nginx" target="fe2">
