    <mxCell id="legend" value="Configuration notes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f5f1;strokeColor=#d8d5cd;fontColor=#1a1d1f;fontSize=15;fontStyle=1;spacingLeft=18;spacingTop=14;arcSize=4;" vertex="1" parent="1">
      <mxGeometry x="60" y="1470" width="1360" height="60" as="geometry" />
    </mxCell>
    <mxCell id="legend1" value="1. This is the ONLY v2 variant that inherits v1's strict frontend→backend proxy pattern unmodified — same images, same nginx.conf." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1a1d1f;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="90" y="1505" width="1300" height="20" as="geometry" />
    </mxCell>

