<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1500" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8ECF1;strokeColor=none;movable=0;resizable=0;editable=0;locked=1;" vertex="1" parent="1">
      <mxGeometry x="-20" y="-20" width="1520" height="1540" as="geometry" />
    </mxCell>

    <mxCell id="title" value="Pathgate v2 — Elastic Beanstalk (Single Instance, no load balancer)" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1a1d1f;" vertex="1" parent="1">
      <mxGeometry x="200" y="16" width="1080" height="36" as="geometry" />
    </mxCell>
    <mxCell id="subtitle" value="EnvironmentType: SingleInstance — an Elastic IP goes straight on the instance, no ELB in front." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5b6167;" vertex="1" parent="1">
      <mxGeometry x="240" y="50" width="1000" height="24" as="geometry" />
    </mxCell>

    <mxCell id="caveat" value="&lt;b&gt;⚠ Still 1 EC2 instance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;Removing the load balancer removes&lt;br&gt;the ELB and Auto Scaling Group, but&lt;br&gt;Beanstalk's Docker platform has no&lt;br&gt;serverless mode -- eb create still&lt;br&gt;provisions exactly one EC2 instance&lt;br&gt;to run docker compose on. There is&lt;br&gt;no way to remove that and still be&lt;br&gt;running Elastic Beanstalk. See the&lt;br&gt;folder README for detail.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fdeded;strokeColor=#c0392b;fontColor=#1a1d1f;fontSize=13;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="60" y="100" width="330" height="220" as="geometry" />
    </mxCell>

    <mxCell id="client" value="Browser" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Basic-2519/browser-809.svg;fontSize=13;fontStyle=1;fontColor=#1a1d1f;" vertex="1" parent="1">
      <mxGeometry x="710" y="110" width="60" height="60" as="geometry" />
    </mxCell>

    <mxCell id="trace" value="&lt;b&gt;Trace: GET /app1/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;1. Browser → Elastic IP :80&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(pinned to the ONE instance,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;no ELB in between)&lt;br&gt;2. docker-compose's nginx container&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(:80 on the instance) does the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;SAME path routing as v1&lt;br&gt;3. location /app1/ strips prefix →&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;frontend1:3000&lt;br&gt;4. container pathgate-eb-compose-&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;frontend-insert (pulled from ECR)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;serves it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fffbe6;strokeColor=#d4b106;fontColor=#1a1d1f;fontSize=13;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="1020" y="90" width="360" height="270" as="geometry" />
    </mxCell>

    <mxCell id="eip" value="&lt;b&gt;Elastic IP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;attached directly to the instance&lt;br&gt;— no load balancer, no ASG&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;:80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#8a4200;fontColor=#ffffff;fontSize=15;arcSize=8;shadow=0;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="600" y="360" width="280" height="100" as="geometry" />
    </mxCell>

    <mxCell id="ec2box" value="&lt;b&gt;EC2 instance&lt;/b&gt; (Single-Instance Beanstalk environment)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal;color:#8a4200&quot;&gt;runs: docker compose up — 4 containers, one bridge network&lt;/font&gt;" style="rounded=1;dashed=1;arcSize=4;strokeColor=#ED7100;fillColor=#ED710008;verticalAlign=top;align=left;fontSize=15;fontStyle=1;fontColor=#8a4200;spacingLeft=20;spacingTop=16;html=1;" vertex="1" parent="1">
      <mxGeometry x="120" y="500" width="1240" height="760" as="geometry" />
    </mxCell>

    <mxCell id="nginx" value="&lt;b&gt;nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-family:monospace;color:#0a4a42&quot;&gt;image: pathgate-eb-compose-nginx&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#0a4a42&quot;&gt;talks to frontends only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f6e63;strokeColor=#0a4a42;fontColor=#ffffff;fontSize=15;arcSize=8;shadow=0;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="640" y="550" width="280" height="130" as="geometry" />
    </mxCell>

    <mxCell id="fe1" value="&lt;img src='https://icons.diagrams.net/assets/carbon-icons/1/Logo_React.svg' width='20' height='20'/&gt;&lt;br&gt;&lt;b&gt;frontend1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#1f4e79&quot;&gt;image: pathgate-eb-compose-frontend-insert&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#3f7fbf&quot;&gt;INSERT ONLY · own nginx&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#3f7fbf;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
