<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1550" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="title" value="Pathgate v2 — Elastic Beanstalk" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1a1d1f;" vertex="1" parent="1">
      <mxGeometry x="340" y="16" width="800" height="36" as="geometry" />
    </mxCell>
    <mxCell id="subtitle" value="Reuses v1's images unchanged — nginx does the routing again, one level down from EB's own ALB." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5b6167;" vertex="1" parent="1">
      <mxGeometry x="280" y="50" width="920" height="24" as="geometry" />
    </mxCell>

    <mxCell id="caveat" value="&lt;b&gt;⚠ Not EC2-free&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;Elastic Beanstalk's Docker platform&lt;br&gt;provisions and manages an EC2 Auto&lt;br&gt;Scaling Group for you. This Terraform&lt;br&gt;never calls aws_instance directly, but&lt;br&gt;an EC2 instance exists once you apply.&lt;br&gt;See the folder README for detail.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fdeded;strokeColor=#c0392b;fontColor=#1a1d1f;fontSize=13;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="60" y="100" width="330" height="180" as="geometry" />
    </mxCell>

    <mxCell id="client" value="Browser" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Basic-2519/browser-809.svg;fontSize=13;fontStyle=1;fontColor=#1a1d1f;" vertex="1" parent="1">
      <mxGeometry x="710" y="110" width="60" height="60" as="geometry" />
    </mxCell>

    <mxCell id="trace" value="&lt;b&gt;Trace: GET /app1/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;1. Browser → EB ALB :80&lt;br&gt;2. EB ALB forwards EVERYTHING to&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;the instance — no path rules; EB&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;itself does no routing here&lt;br&gt;3. docker-compose's nginx container&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(:80 on the instance) does the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;SAME path routing as v1&lt;br&gt;4. location /app1/ strips prefix →&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;frontend1:3000&lt;br&gt;5. container pathgate-frontend-insert&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(pulled from ECR) serves it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fffbe6;strokeColor=#d4b106;fontColor=#1a1d1f;fontSize=13;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="1020" y="90" width="360" height="270" as="geometry" />
    </mxCell>

    <mxCell id="eb-alb" value="&lt;b&gt;EB-managed ALB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;created automatically by the&lt;br&gt;Elastic Beanstalk environment&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;listener :80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#8a4200;fontColor=#ffffff;fontSize=15;arcSize=8;shadow=0;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="600" y="330" width="280" height="110" as="geometry" />
    </mxCell>

    <mxCell id="ec2box" value="&lt;b&gt;EC2 instance&lt;/b&gt; (EB-managed Auto Scaling Group)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal;color:#8a4200&quot;&gt;runs: docker compose up — 4 containers, one bridge network&lt;/font&gt;" style="rounded=1;dashed=1;arcSize=4;strokeColor=#ED7100;fillColor=#ED710008;verticalAlign=top;align=left;fontSize=15;fontStyle=1;fontColor=#8a4200;spacingLeft=20;spacingTop=16;html=1;" vertex="1" parent="1">
      <mxGeometry x="120" y="480" width="1240" height="760" as="geometry" />
    </mxCell>

    <mxCell id="nginx" value="&lt;b&gt;nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-family:monospace;color:#0a4a42&quot;&gt;image: pathgate-eb-nginx&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#0a4a42&quot;&gt;talks to frontends only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f6e63;strokeColor=#0a4a42;fontColor=#ffffff;fontSize=15;arcSize=8;shadow=0;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="640" y="530" width="280" height="130" as="geometry" />
    </mxCell>

    <mxCell id="fe1" value="&lt;img src='https://icons.diagrams.net/assets/carbon-icons/1/Logo_React.svg' width='20' height='20'/&gt;&lt;br&gt;&lt;b&gt;frontend1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#1f4e79&quot;&gt;image: pathgate-eb-frontend-insert&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#3f7fbf&quot;&gt;INSERT ONLY · own nginx&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#3f7fbf;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="180" y="700" width="320" height="180" as="geometry" />
    </mxCell>

    <mxCell id="fe2" value="&lt;img src='https://icons.diagrams.net/assets/carbon-icons/1/Logo_React.svg' width='20' height='20'/&gt;&lt;br&gt;&lt;b&gt;frontend2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#1f4e79&quot;&gt;image: pathgate-eb-frontend-list&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#3f7fbf&quot;&gt;LIST ONLY · own nginx&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#3f7fbf;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="980" y="700" width="320" height="180" as="geometry" />
    </mxCell>

    <mxCell id="backend" value="&lt;b&gt;backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#8a3a0f&quot;&gt;image: pathgate-eb-backend&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#b3541e&quot;&gt;reached only via frontends&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 8000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeee0;strokeColor=#b3541e;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="640" y="960" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#8a2a90&quot;&gt;identifier: pathgate-eb-db&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#6b4fa0&quot;&gt;outside the instance — managed RDS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 5432&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe9fb;strokeColor=#6b4fa0;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="640" y="1300" width="280" height="150" as="geometry" />
    </mxCell>

    <mxCell id="e1" value="① :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#1a1d1f;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="client" target="eb-alb">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e2" value="② all traffic → instance :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#8a4200;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eb-alb" target="nginx">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e3" value="③ /app1 → :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#0f6e63;strokeWidth=1.5;endArrow=block;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nginx" target="fe1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="0" y="-30" as="offset" />
      </mxGeometry>
    </mxCell>

    <mxCell id="e4" value="③ /app2 → :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#0f6e63;strokeWidth=1.5;endArrow=block;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nginx" target="fe2">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="0" y="-30" as="offset" />
      </mxGeometry>
    </mxCell>

    <mxCell id="e5a" value="④ /api → :8000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#b3541e;strokeWidth=1.5;dashed=1;endArrow=block;exitX=0.7;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="fe1" target="backend">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e5b" value="④ /api → :8000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#b3541e;strokeWidth=1.5;dashed=1;endArrow=block;exitX=0.3;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="fe2" target="backend">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e6" value="⑤ SQL :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#6b4fa0;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="backend" target="rds">
