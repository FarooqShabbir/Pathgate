<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1400" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="title" value="Pathgate v2 — ECS Fargate" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1a1d1f;" vertex="1" parent="1">
      <mxGeometry x="380" y="16" width="720" height="36" as="geometry" />
    </mxCell>
    <mxCell id="subtitle" value="No EC2 — serverless containers. ALB replaces nginx as the router; it does NOT strip matched paths." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5b6167;" vertex="1" parent="1">
      <mxGeometry x="280" y="50" width="920" height="24" as="geometry" />
    </mxCell>

    <mxCell id="client" value="Browser" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Basic-2519/browser-809.svg;fontSize=13;fontStyle=1;fontColor=#1a1d1f;" vertex="1" parent="1">
      <mxGeometry x="710" y="110" width="60" height="60" as="geometry" />
    </mxCell>

    <mxCell id="trace" value="&lt;b&gt;Trace: GET /app1/*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;1. Browser → ALB :80 (public)&lt;br&gt;2. Listener rule &lt;b&gt;path=/app1*&lt;/b&gt; matches&lt;br&gt;3. Forward → target group&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;pathgate-app1-tg&lt;/b&gt;&lt;br&gt;4. Target = Fargate task, family&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;pathgate-frontend-insert&lt;/b&gt;, port 80&lt;br&gt;5. Full path forwarded UNCHANGED —&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;task's own nginx (Dockerfile.ecs)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;already serves under /app1/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fffbe6;strokeColor=#d4b106;fontColor=#1a1d1f;fontSize=13;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="1020" y="100" width="360" height="230" as="geometry" />
    </mxCell>

    <mxCell id="vpc" value="&lt;b&gt;VPC&lt;/b&gt; (pathgate-vpc)" style="rounded=1;dashed=1;arcSize=4;strokeColor=#8a8f96;fillColor=none;verticalAlign=top;align=left;fontSize=15;fontStyle=1;fontColor=#1a1d1f;spacingLeft=20;spacingTop=16;html=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="230" width="1360" height="1080" as="geometry" />
    </mxCell>

    <mxCell id="pubsub" value="&lt;b&gt;Public subnets&lt;/b&gt; — ALB + Fargate tasks (assign_public_ip=true, no NAT needed)" style="rounded=1;dashed=1;arcSize=4;strokeColor=#8C4FFF;fillColor=#8C4FFF08;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#5b3a99;spacingLeft=16;spacingTop=12;html=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="280" width="1280" height="640" as="geometry" />
    </mxCell>

    <mxCell id="alb" value="&lt;b&gt;Application Load Balancer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-family:monospace;color:#5b3a99&quot;&gt;name: pathgate-alb&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;listener :80 (HTTP)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#5b3a99;fontColor=#ffffff;fontSize=15;arcSize=8;shadow=0;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="600" y="330" width="280" height="100" as="geometry" />
    </mxCell>

    <mxCell id="fe1" value="&lt;img src='https://icons.diagrams.net/assets/carbon-icons/1/Logo_React.svg' width='20' height='20'/&gt;&lt;br&gt;&lt;b&gt;frontend-insert task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#1f4e79&quot;&gt;family: pathgate-frontend-insert&lt;br&gt;image: Dockerfile.ecs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#3f7fbf&quot;&gt;own nginx, scoped to /app1/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;container port 80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#3f7fbf;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="140" y="530" width="320" height="200" as="geometry" />
    </mxCell>

    <mxCell id="fe2" value="&lt;img src='https://icons.diagrams.net/assets/carbon-icons/1/Logo_React.svg' width='20' height='20'/&gt;&lt;br&gt;&lt;b&gt;frontend-list task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#1f4e79&quot;&gt;family: pathgate-frontend-list&lt;br&gt;image: Dockerfile.ecs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#3f7fbf&quot;&gt;own nginx, scoped to /app2/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;container port 80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#3f7fbf;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="1020" y="530" width="320" height="200" as="geometry" />
    </mxCell>

    <mxCell id="backend" value="&lt;b&gt;backend task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#8a3a0f&quot;&gt;family: pathgate-backend&lt;br&gt;sg: tasks SG (inbound from ALB SG only)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;FastAPI (uvicorn)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#b3541e&quot;&gt;routes mounted under /api&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;container port 8000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeee0;strokeColor=#b3541e;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="600" y="770" width="280" height="180" as="geometry" />
    </mxCell>

    <mxCell id="privsub" value="&lt;b&gt;Private subnets&lt;/b&gt; — no route to the internet" style="rounded=1;dashed=1;arcSize=4;strokeColor=#C925D1;fillColor=#C925D108;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#8a2a90;spacingLeft=16;spacingTop=12;html=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="960" width="1280" height="300" as="geometry" />
    </mxCell>

    <mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#8a2a90&quot;&gt;identifier: pathgate-db&lt;br&gt;engine: postgres 16 · db.t4g.micro&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#6b4fa0&quot;&gt;sg: db SG (inbound from tasks SG only)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;port 5432&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe9fb;strokeColor=#6b4fa0;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="600" y="1010" width="280" height="180" as="geometry" />
    </mxCell>

    <mxCell id="e1" value="① :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#1a1d1f;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="client" target="alb">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e2" value="② rule: /app1* → tg :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=1.5;endArrow=block;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="alb" target="fe1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="0" y="-30" as="offset" />
      </mxGeometry>
    </mxCell>

    <mxCell id="e3" value="② rule: /app2* → tg :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=1.5;endArrow=block;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="alb" target="fe2">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="0" y="-30" as="offset" />
      </mxGeometry>
    </mxCell>

    <mxCell id="e4" value="③ rule: /api* → tg :8000 (DIRECT — differs from v1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="alb" target="backend">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e5" value="④ SQL :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#6b4fa0;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="backend" target="rds">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="legend" value="Configuration notes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f5f1;strokeColor=#d8d5cd;fontColor=#1a1d1f;fontSize=15;fontStyle=1;spacingLeft=18;spacingTop=14;arcSize=4;" vertex="1" parent="1">
      <mxGeometry x="60" y="1330" width="1360" height="60" as="geometry" />
    </mxCell>
    <mxCell id="legend1" value="1. The ALB does not strip a matched path — that's why the frontend tasks run their OWN nginx (Dockerfile.ecs), already scoped to /app1/ or /app2/, unlike v1's plain static server." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1a1d1f;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="90" y="1365" width="1300" height="20" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
