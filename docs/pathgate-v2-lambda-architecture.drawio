<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1300" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8ECF1;strokeColor=none;movable=0;resizable=0;editable=0;locked=1;" vertex="1" parent="1">
      <mxGeometry x="-20" y="-20" width="1520" height="1340" as="geometry" />
    </mxCell>

    <mxCell id="title" value="Pathgate v2 — AWS Lambda (plain AWS CLI, fully serverless)" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1a1d1f;" vertex="1" parent="1">
      <mxGeometry x="240" y="16" width="1000" height="36" as="geometry" />
    </mxCell>
    <mxCell id="subtitle" value="No EC2, no load balancer — CloudFront is a CDN/router, API Gateway is a managed front door, neither is a load balancer." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5b6167;" vertex="1" parent="1">
      <mxGeometry x="200" y="50" width="1080" height="24" as="geometry" />
    </mxCell>

    <mxCell id="caveat" value="&lt;b&gt;⚠ No frontend tier to proxy through&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;S3 is files, not compute -- it can't&lt;br&gt;proxy /api/* onward the way nginx&lt;br&gt;does elsewhere. The browser calls&lt;br&gt;the backend directly via CloudFront&lt;br&gt;instead. Structural, not a shortcut&lt;br&gt;-- see the folder README.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fdeded;strokeColor=#c0392b;fontColor=#1a1d1f;fontSize=13;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="60" y="100" width="330" height="170" as="geometry" />
    </mxCell>

    <mxCell id="client" value="Browser" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=none;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Basic-2519/browser-809.svg;fontSize=13;fontStyle=1;fontColor=#1a1d1f;" vertex="1" parent="1">
      <mxGeometry x="710" y="100" width="60" height="60" as="geometry" />
    </mxCell>

    <mxCell id="trace" value="&lt;b&gt;Trace: GET /app1/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;1. Browser → CloudFront (https)&lt;br&gt;2. Behavior &lt;b&gt;path=/app1/*&lt;/b&gt; matches&lt;br&gt;3. CloudFront Function rewrites&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;/app1/ → /app1/index.html&lt;br&gt;4. Origin = S3 bucket, key&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;app1/index.html&lt;/b&gt;, via OAC&lt;br&gt;&lt;b&gt;Trace: POST insert&lt;/b&gt;&lt;br&gt;5. Page's own fetch('/api/items')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;— ABSOLUTE (VITE_API_BASE=/api)&lt;br&gt;6. Behavior &lt;b&gt;path=/api/*&lt;/b&gt; matches&lt;br&gt;7. Origin = API Gateway → Lambda&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fffbe6;strokeColor=#d4b106;fontColor=#1a1d1f;fontSize=13;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="1020" y="80" width="360" height="300" as="geometry" />
    </mxCell>

    <mxCell id="cf" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;behaviors: /app1/*, /app2/*, /api/*&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;edge :443 (HTTPS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#5b3a99;fontColor=#ffffff;fontSize=15;arcSize=8;shadow=0;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="600" y="290" width="280" height="110" as="geometry" />
    </mxCell>

    <mxCell id="s3-1" value="&lt;b&gt;S3: app1 bucket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#4d6b1a&quot;&gt;pathgate-lambda-app1-&amp;lt;account&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#4d6b1a&quot;&gt;static files, key prefix app1/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;private bucket, OAC only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7e0;strokeColor=#7AA116;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="120" y="500" width="320" height="180" as="geometry" />
    </mxCell>

    <mxCell id="s3-2" value="&lt;b&gt;S3: app2 bucket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#4d6b1a&quot;&gt;pathgate-lambda-app2-&amp;lt;account&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#4d6b1a&quot;&gt;static files, key prefix app2/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;private bucket, OAC only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7e0;strokeColor=#7AA116;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="1040" y="500" width="320" height="180" as="geometry" />
    </mxCell>

    <mxCell id="apigw" value="&lt;b&gt;API Gateway (HTTP API)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#8a0f4d&quot;&gt;name: pathgate-lambda-api&lt;br&gt;route: ANY /api/{proxy+}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;stage: $default (auto-deploy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4f0;strokeColor=#E7157B;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="580" y="500" width="320" height="120" as="geometry" />
    </mxCell>

    <mxCell id="lambda" value="&lt;b&gt;Lambda: backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#8a3a0f&quot;&gt;function: pathgate-lambda-backend&lt;br&gt;handler: handler.handler&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#b3541e&quot;&gt;Mangum(app) wraps the SAME&lt;br&gt;FastAPI app as every other variant&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:bold&quot;&gt;python3.12 · 256MB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeee0;strokeColor=#b3541e;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="580" y="690" width="320" height="190" as="geometry" />
    </mxCell>

    <mxCell id="ddb" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;font-family:monospace;color:#8a2a90&quot;&gt;table: pathgate-lambda-items&lt;br&gt;billing: PAY_PER_REQUEST&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:bold;color:#6b4fa0&quot;&gt;replaces Postgres for this variant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe9fb;strokeColor=#6b4fa0;fontColor=#1a1d1f;fontSize=15;arcSize=8;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="580" y="940" width="320" height="140" as="geometry" />
    </mxCell>

    <mxCell id="e1" value="① :443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#1a1d1f;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="client" target="cf">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e2" value="② /app1/* → S3 origin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#7AA116;strokeWidth=1.5;endArrow=block;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cf" target="s3-1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="0" y="-30" as="offset" />
      </mxGeometry>
    </mxCell>

    <mxCell id="e3" value="② /app2/* → S3 origin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#7AA116;strokeWidth=1.5;endArrow=block;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cf" target="s3-2">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="0" y="-30" as="offset" />
      </mxGeometry>
    </mxCell>

    <mxCell id="e4" value="③ /api/* → API GW origin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#E7157B;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cf" target="apigw">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e5" value="④ AWS_PROXY integration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#b3541e;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apigw" target="lambda">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e6" value="⑤ boto3: PutItem / Scan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontColor=#1a1d1f;labelBackgroundColor=#ffffff;strokeColor=#6b4fa0;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lambda" target="ddb">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="legend" value="Configuration notes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f5f1;strokeColor=#d8d5cd;fontColor=#1a1d1f;fontSize=15;fontStyle=1;spacingLeft=18;spacingTop=14;arcSize=4;" vertex="1" parent="1">
      <mxGeometry x="60" y="1110" width="1360" height="150" as="geometry" />
    </mxCell>
    <mxCell id="legend1" value="1. Every resource created with plain aws-cli calls (01-setup-lambda.sh, 02-setup-cloudfront.sh) -- no Terraform, no CloudFormation, no SAM." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1a1d1f;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="90" y="1150" width="1300" height="24" as="geometry" />
    </mxCell>
    <mxCell id="legend2" value="2. S3 has no directory-index concept — a CloudFront Function rewrites /app1/ → /app1/index.html at the edge before the origin fetch." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1a1d1f;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="90" y="1174" width="1300" height="24" as="geometry" />
    </mxCell>
    <mxCell id="legend3" value="3. Same backend source as every other variant (apps/backend/app/main.py) — only STORAGE_BACKEND=dynamodb and the Mangum wrapper differ." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1a1d1f;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="90" y="1198" width="1300" height="24" as="geometry" />
    </mxCell>
    <mxCell id="legend4" value="4. Genuinely no EC2 and no load balancer here — the one v2 target where both constraints are free, not a trade-off." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1a1d1f;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="90" y="1222" width="1300" height="24" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
